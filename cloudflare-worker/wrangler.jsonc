{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sports-erp-api-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-27",
  // 커스텀 도메인 없이 <name>.<계정 서브도메인>.workers.dev 로 바로 배포된다(D24 참고).
  // D37 — API_ORIGIN(origin 주소)은 vars가 아니라 Worker secret으로 둔다. 공개 저장소에 Lambda Function URL이
  // 남으면 403 요청만으로도 호출 과금이 생기기 때문이다. 값은 Function URL(별칭 live, 끝 "/" 없이), 전환 전에는
  // Render 주소. 넣는 방법은 aws-lambda/README.md 5번(`wrangler deploy --secrets-file`).
  // required에 있으면 secret이 없을 때 wrangler deploy가 실패한다 — origin 없이 배포되는 것을 막는다.
  "secrets": {
    "required": ["API_ORIGIN"]
  },
  // D25 — admin-web(Render Static Site)을 이 Worker의 정적 자산으로 흡수한다.
  // run_worker_first를 /api/*로만 한정해서, UI 요청(/,/members 등)은 index.ts를 아예
  // 거치지 않고 바로 정적 자산 계층에서 처리된다 — UI와 API가 같은 오리진이 되어
  // CORS가 아예 성립하지 않게 된다. not_found_handling=SPA로 새로고침 404도 해결
  // (Render의 _redirects는 동작이 미검증 상태였음, D23 참고).
  // D41 — 회원 웹(apps/member-web)은 같은 dist의 m/ 아래에 빌드된다. SPA 폴백은 루트 index.html(관리자)만
  // 주므로 /m/* 화면 경로는 Worker가 먼저 받아 /m/index.html을 준다. 진입 경로 /m/와 빌드 산출물 /m/assets/*는
  // 자산 계층이 바로 처리하게 뺀다 — Worker 호출은 깊은 경로를 새로고침할 때만 생긴다(design-constants ⑬,
  // 방문마다 1회씩 더하면 하루 약 0.8만 건이 늘어 무료 한도 10만을 넘는다). wrangler dev로 확인(log/077).
  "assets": {
    "directory": "../apps/admin-web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // D45 — 회원 앱 service worker(/m/sw.js)도 자산 계층이 바로 준다(브라우저가 업데이트 확인으로 자주 부른다).
    "run_worker_first": ["/api/*", "/m/*", "!/m/", "!/m/assets/*", "!/m/sw.js"]
  },
  // Workers Rate Limiting(2025-09-19 GA). simple: 지정한 period(초) 동안 limit회 초과 시 거부.
  "unsafe": {
    "bindings": [
      {
        "name": "LOGIN_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 10, "period": 60 }
      }
    ]
  }
}

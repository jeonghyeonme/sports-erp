// 스포이즘 ERP — 전체 스키마
// 1-2~1-9 기능 문서의 데이터 모델을 그대로 반영합니다. 문서 번호는 각 모델 위 주석 참고(docs/1.spec/ 하위 폴더는 README 문서 표 참고).

generator client {
  provider      = "prisma-client-js"
  // native = 로컬/CI, rhel-openssl-3.0.x = AWS Lambda(Node 20, Amazon Linux 2023) — D27, D26 "다음 작업" ④
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// D27 — url은 앱 런타임 연결(Supabase에선 트랜잭션 풀러 6543 + ?pgbouncer=true&connection_limit=1,
// Lambda 동시 인스턴스마다 연결을 열어 DB 커넥션이 고갈되는 것을 막는다 — D26 "다음 작업" ②),
// directUrl은 마이그레이션 전용 직접 연결(5432). 로컬/CI는 둘 다 같은 값이면 된다.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── D27: 날짜 컬럼 규칙(docs/architecture/date-time-handling.md) ──
// "YYYY-MM-DD" 의미의 필드는 @db.Date이고 DB 기본값(now())을 두지 않는다 — DB의 now()는 UTC라
// 00:00~08:59 KST에 하루 전 날짜가 들어간다(2026-09-23에 고친 버그의 재발 경로). 앱이 todayKst()로 채운다.
//
// ── D27: 부분 unique 인덱스(Prisma 5 스키마 문법으로 표현 불가 — 마이그레이션 SQL에만 있다) ──
// 1) Account(email) WHERE isActive                                              — ADR-MEM-02
// 2) StaffAssignment(staffId) WHERE endDate IS NULL                             — ADR-STF-03
// 3) Reservation(memberId, scheduleSlotId) WHERE status IN (REQUESTED, CONFIRMED) — ADR-RSV-02
// Prisma 5.22의 `migrate dev`는 이 인덱스들을 건드리지 않음을 확인했다(2026-09-29, 빈 마이그레이션 생성).
// Prisma 버전을 올린 뒤 새 마이그레이션에 이 인덱스의 DROP INDEX가 생기면 지우고 커밋할 것.

// ── 공통 enum ──────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  BRANCH_ADMIN
  STAFF // 지점 소속 일반 직원(트레이너 등) — 관리 권한 없이 본인 근태/휴가/업무일지만 셀프서비스 (1-2문서 §7)
  MEMBER
}

// ── 1-2. 권한관리 / 조직 ────────────────────────────────

model Account {
  id               String    @id @default(uuid())
  email            String // 부분 unique(활성 계정끼리만) — 파일 상단 주석 1). findUnique 불가, findFirst 사용
  passwordHash     String
  role             Role
  name             String // SUPER_ADMIN은 Staff/Member 프로필이 없어 이름을 여기 직접 둔다 — Staff/Member 보유 계정도 조회 편의상 함께 저장(항상 그쪽 name과 동기화)
  isActive         Boolean   @default(true)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  staff                Staff?
  member               Member?
  refreshTokens        RefreshToken[]
  auditLogs            AuditLog[]
  staffAssignmentsMade StaffAssignment[] // 이 계정이 SUPER_ADMIN으로서 발령한 파견 이력(assignedBy)

  @@index([email])
  @@index([role])
}

model RefreshToken {
  id        String    @id @default(uuid())
  accountId String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model Branch {
  id                        String               @id @default(uuid())
  name                      String
  code                      String               @unique // 지점 코드 — memberNo/staffCode 생성에 사용 (예: "SEOCHO"). 1-3(staffCode)/1-6(memberNo)문서 참고
  address                   String?
  region                    String // 광역 단위(예: "서울", "경기") — address(상세 주소)와 별개로 대시보드 지역별 그룹핑에 사용
  phone                     String?
  standardCheckInTime       String? // "HH:mm" — 1-4문서 지각 판정 기준
  cancellationDeadlineHours Int? // 예약 무료취소 기준 시간(예: 24) — nullable이면 전역 기본값 사용, 1-7문서 §6 참고. 1-1문서 §2-1의 cancellationPolicy를 단순 컬럼으로 구현
  isActive                  Boolean              @default(true)
  // 위탁계약 필드 — 1-1문서 §2-1. Branch는 매장이 아니라 위탁운영 계약 현장이라는 재해석의 핵심 데이터.
  contractPartner           String // 위탁계약 상대방(예: "서초 OO아파트 입주자대표회의") — 관리자 전용 정보
  contractStartAt           DateTime             @db.Date
  contractEndAt             DateTime?            @db.Date
  contractStatus            BranchContractStatus @default(ACTIVE)
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  staff             Staff[]
  staffAssignments  StaffAssignment[]
  attendanceRecords AttendanceRecord[]
  members           Member[]
  facilities        Facility[]
  instructors       Instructor[]
  programs          Program[]
  posts             Post[]
  assets            Asset[]
  documents         Document[]
  codeSequences     CodeSequence[]

  @@index([isActive])
  @@index([contractStatus])
  @@index([contractEndAt])
  @@index([region])
}

enum BranchContractStatus {
  ACTIVE
  RENEWAL_DUE
  EXPIRED
  TERMINATED
}

// ── 1-3. 인사정보관리 ───────────────────────────────────

enum StaffStatus {
  ACTIVE // 재직
  ON_LEAVE // 휴직
  RESIGNED // 퇴사
}

model Staff {
  id             String      @id @default(uuid())
  accountId      String      @unique
  branchId       String
  staffCode      String      @unique
  name           String
  phone          String?
  position       String? // 팀장/지점장/트레이너/행정직원 등
  employmentType String? // 정규직/계약직/파트타임
  hireDate       DateTime    @db.Date
  resignDate     DateTime?   @db.Date
  status         StaffStatus @default(ACTIVE)
  offDays        Int[]       @default([]) // 주간 정기 휴무 요일(0=일~6=토) — 근태 isWorkDay 판정에 사용
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id])

  changeRequests    StaffProfileChangeRequest[]
  attendanceRecords AttendanceRecord[]
  leaveRequests     LeaveRequest[]
  leaveBalances     LeaveBalance[]
  workLogs          WorkLog[]
  instructorProfile Instructor?
  assignedMembers   Member[]                    @relation("StaffAssignedMembers")
  assignments       StaffAssignment[] // 파견 이력 — 1-1문서 §2-2

  @@index([branchId])
  @@index([status])
}

// 파견 이력 — 1-1문서 §2-2, 1-3문서 §3~§7. Staff.branchId는 이 중 endDate=null인 레코드의
// branchId와 항상 동기화되는 비정규화 캐시(원천은 이 테이블). 한 직원당 endDate=null 레코드는
// 최대 1건이어야 한다는 불변식은 애플리케이션 레벨(트랜잭션)에서 보장한다.
model StaffAssignment {
  id         String    @id @default(uuid())
  staffId    String
  branchId   String
  startDate  DateTime  @db.Date
  endDate    DateTime? @db.Date // null = 현재 진행 중인 파견
  assignedBy String // FK → Account, 항상 SUPER_ADMIN(파견 발령은 본사 전용)
  note       String?
  createdAt  DateTime  @default(now())

  staff             Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branch            Branch  @relation(fields: [branchId], references: [id])
  assignedByAccount Account @relation(fields: [assignedBy], references: [id])

  @@index([staffId, endDate])
  @@index([branchId, startDate])
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model StaffProfileChangeRequest {
  id         String              @id @default(uuid())
  staffId    String
  field      String
  oldValue   String?
  newValue   String
  status     ChangeRequestStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime            @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, status])
}

// ── 1-4. 근태관리 ───────────────────────────────────────

enum AttendanceStatus {
  NORMAL // 정상
  LATE // 지각
  EARLY_LEAVE // 조퇴
  ABSENT // 결근
  ON_LEAVE // 휴가
}

model AttendanceRecord {
  id         String           @id @default(uuid())
  staffId    String
  branchId   String // 체크인 시점 지점 스냅샷 — 파견 재배치 중에도 과거 기록의 지점이 바뀌지 않도록 고정(ADR-ATT-03)
  date       DateTime         @db.Date
  checkInAt  DateTime?
  checkOutAt DateTime?
  status     AttendanceStatus @default(NORMAL)
  note       String?
  createdAt  DateTime         @default(now())

  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([staffId, date])
  @@index([staffId, date])
  @@index([branchId])
}

enum LeaveType {
  ANNUAL // 연차
  SICK // 병가
  FAMILY_EVENT // 경조사
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveRequest {
  id         String      @id @default(uuid())
  staffId    String
  type       LeaveType
  startDate  DateTime    @db.Date
  endDate    DateTime    @db.Date
  days       Int
  reason     String?
  status     LeaveStatus @default(PENDING)
  approverId String?
  reviewedAt DateTime?
  createdAt  DateTime    @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, status])
}

model LeaveBalance {
  id        String @id @default(uuid())
  staffId   String
  year      Int
  totalDays Int
  usedDays  Int    @default(0)

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, year])
}

model WorkLog {
  id        String   @id @default(uuid())
  staffId   String
  date      DateTime @db.Date
  content   String
  createdAt DateTime @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, date])
}

// ── 1-5. 게시판(공지사항) ───────────────────────────────

enum PostScope {
  HQ_TO_BRANCH
  BRANCH_TO_MEMBER
}

enum PostCategory {
  NOTICE // 공지
  TRAINING_MATERIAL // 교육자료
  EVENT // 이벤트
  OTHER
}

model Post {
  id              String       @id @default(uuid())
  scope           PostScope
  branchId        String? // HQ_TO_BRANCH + null = 전체 지점 공지
  authorId        String
  category        PostCategory @default(NOTICE)
  title           String
  content         String
  pinned          Boolean      @default(false)
  visibleToMember Boolean      @default(false) // HQ 공지의 회원 노출 여부
  viewCount       Int          @default(0)
  publishedAt     DateTime     @db.Date // 앱이 todayKst()로 채움(파일 상단 날짜 규칙)
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  branch       Branch?           @relation(fields: [branchId], references: [id])
  attachments  Attachment[]
  readReceipts PostReadReceipt[]

  @@index([scope, branchId, publishedAt])
}

model Attachment {
  id       String @id @default(uuid())
  postId   String
  url      String
  fileName String
  fileType String
  fileSize Int

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model PostReadReceipt {
  id        String   @id @default(uuid())
  postId    String
  accountId String
  readAt    DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, accountId])
}

// ── 1-6. 회원관리 ───────────────────────────────────────

enum MemberStatus {
  ACTIVE // 활성
  DORMANT // 휴면
  WITHDRAWN // 탈퇴
}

model Member {
  id              String       @id @default(uuid())
  accountId       String?      @unique
  branchId        String
  assignedStaffId String? // 담당 트레이너 등(선택) — 없으면 회원권만 등록하고 담당 직원이 없는 회원
  memberNo        String       @unique
  name            String
  phone           String?
  birthDate       DateTime?    @db.Date
  gender          String?
  joinedAt        DateTime     @db.Date // 앱이 todayKst()로 채움(파일 상단 날짜 규칙)
  status          MemberStatus @default(ACTIVE)
  guardianConsent Boolean      @default(false) // 미성년 회원 법정대리인 동의 (05문서 §3·§6)
  memo            String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  account       Account? @relation(fields: [accountId], references: [id])
  branch        Branch   @relation(fields: [branchId], references: [id])
  assignedStaff Staff?   @relation("StaffAssignedMembers", fields: [assignedStaffId], references: [id])

  enrollments  CourseEnrollment[]
  ptSessions   PTSession[]
  reservations Reservation[]
  payments     Payment[]
  checkIns     FacilityCheckIn[]

  @@index([branchId])
  @@index([phone])
  @@index([assignedStaffId])
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model CourseEnrollment {
  id         String           @id @default(uuid())
  memberId   String
  programId  String
  enrolledAt DateTime         @db.Date
  expiresAt  DateTime?        @db.Date
  status     EnrollmentStatus @default(ACTIVE)

  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id])

  @@index([memberId])
}

model PTSession {
  id            String   @id @default(uuid())
  memberId      String
  programId     String
  totalSessions Int
  usedSessions  Int      @default(0)
  purchasedAt   DateTime @db.Date

  member  Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  program Program        @relation(fields: [programId], references: [id])
  logs    PTSessionLog[]

  @@index([memberId])
}

model PTSessionLog {
  id          String   @id @default(uuid())
  ptSessionId String
  usedAt      DateTime @default(now())
  note        String?

  ptSession PTSession @relation(fields: [ptSessionId], references: [id], onDelete: Cascade)

  @@index([ptSessionId])
}

// ── 1-8. 강사·프로그램 게시 ──────────────────────────────

model Instructor {
  id        String  @id @default(uuid())
  branchId  String
  staffId   String? @unique // 소속 직원이 겸임하는 경우 연결(선택)
  name      String
  specialty String?
  bio       String?
  photoUrl  String?
  phone     String?
  isActive  Boolean @default(true)

  branch   Branch    @relation(fields: [branchId], references: [id])
  staff    Staff?    @relation(fields: [staffId], references: [id])
  programs Program[]

  @@index([branchId])
}

enum AgeGroup {
  ALL // 전체
  CHILD // 유아동
  TEEN // 청소년
  ADULT // 성인
  SENIOR // 시니어
}

enum PricingType {
  FREE_ACCESS // 자유이용형 — 예약/결제 대상 아님 (1-9문서 FacilityCheckIn만 사용)
  PAID_SESSION // 회차 예약형 — price=0이면 무료 회차
  PT_PACKAGE // 세션 차감형(PT) — 1-6문서 PTSession으로 관리
}

enum ProgramStatus {
  PREPARING // 준비중 — 등록됐지만 startDate 이전
  RUNNING // 진행중
  PAUSED // 휴강(일시중단)
  ENDED // 종료
}

model Program {
  id           String        @id @default(uuid())
  branchId     String
  facilityId   String?
  instructorId String?
  name         String
  category     String // 종목: 헬스/수영/골프/요가/독서실이용 등
  ageGroup     AgeGroup      @default(ALL)
  description  String?
  price        Int           @default(0)
  pricingType  PricingType
  capacity     Int?
  status       ProgramStatus @default(PREPARING) // 지점별 "진행중" 파악의 핵심 필드 — §3-2 참고
  startDate    DateTime      @db.Date // 모집/개강일
  endDate      DateTime?     @db.Date // 종료 예정일(상시 운영이면 null)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  branch     Branch      @relation(fields: [branchId], references: [id])
  facility   Facility?   @relation(fields: [facilityId], references: [id])
  instructor Instructor? @relation(fields: [instructorId], references: [id])

  scheduleTemplates ProgramScheduleTemplate[]
  scheduleSlots     ScheduleSlot[]
  enrollments       CourseEnrollment[]
  ptSessions        PTSession[]

  @@index([branchId, status]) // 지점별 진행중 프로그램 조회 최적화
  @@index([branchId, category, ageGroup, pricingType])
}

model ProgramScheduleTemplate {
  id        String @id @default(uuid())
  programId String
  dayOfWeek Int // 0(일)~6(토)
  startTime String // "HH:mm"
  endTime   String

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
}

// ── 1-7. 예약 및 결제 ────────────────────────────────────

model ScheduleSlot {
  id        String   @id @default(uuid())
  programId String
  date      DateTime @db.Date
  startTime String
  endTime   String
  capacity  Int

  program      Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@index([programId, date])
}

enum ReservationStatus {
  REQUESTED // 신청
  CONFIRMED // 확정
  CANCELLED // 취소
  COMPLETED // 완료
  NO_SHOW // 노쇼
}

model Reservation {
  id             String            @id @default(uuid())
  memberId       String
  scheduleSlotId String
  status         ReservationStatus @default(REQUESTED)
  createdAt      DateTime          @default(now())
  cancelledAt    DateTime?
  cancelReason   String?

  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  scheduleSlot ScheduleSlot @relation(fields: [scheduleSlotId], references: [id])
  payment      Payment?

  // (memberId, scheduleSlotId) 유일성은 활성 예약에만 — 부분 unique(파일 상단 주석 3). 전역 @@unique는
  // 취소 후 재예약을 막아 ADR-RSV-02와 모순이었다.
  @@index([memberId, scheduleSlotId])
  @@index([scheduleSlotId, status])
  @@index([memberId, status])
}

enum PaymentMethod {
  MOCK_CARD
  FREE
}

enum PaymentStatus {
  PENDING // 대기
  APPROVED // 승인
  FAILED // 실패
  REFUNDED // 환불
}

model Payment {
  id             String        @id @default(uuid())
  reservationId  String        @unique
  memberId       String
  amount         Int
  supplyAmount   Int // 공급가액 = round(amount / 1.1)
  vat            Int // 부가세 = amount - supplyAmount
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  mockApprovalNo String?
  approvedAt     DateTime?
  refundedAt     DateTime?
  createdAt      DateTime      @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  member      Member      @relation(fields: [memberId], references: [id])

  @@index([memberId])
}

// ── 1-9. 혼잡도 관리 ─────────────────────────────────────

enum FacilityType {
  GYM
  POOL
  GOLF
  READING_ROOM
  ETC
}

model Facility {
  id            String       @id @default(uuid())
  branchId      String
  name          String
  type          FacilityType
  capacity      Int
  isActive      Boolean      @default(true)
  // 혼잡도 현재값 — CongestionSnapshot(이력 테이블)은 스키마엔 있지만 Phase 1 범위 밖이라
  // 아직 안 쓴다. 지금은 mock과 동일하게 Facility에 직접 현재값을 얹는다.
  currentCount  Int          @default(0)
  level         Int          @default(1) // 1~5
  lastUpdatedAt DateTime?

  branch              Branch               @relation(fields: [branchId], references: [id])
  programs            Program[]
  congestionSnapshots CongestionSnapshot[]
  checkIns            FacilityCheckIn[]

  @@index([branchId])
}

enum CongestionSource {
  AUTO
  MANUAL
}

model CongestionSnapshot {
  id           String           @id @default(uuid())
  facilityId   String
  currentCount Int
  capacity     Int
  level        Int // 1~5
  source       CongestionSource
  recordedAt   DateTime         @default(now())

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, recordedAt])
}

model FacilityCheckIn {
  id         String    @id @default(uuid())
  facilityId String
  memberId   String
  checkInAt  DateTime  @default(now())
  checkOutAt DateTime?

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([facilityId, checkOutAt])
}

// ── 1-10. 자원문서관리(Phase 1만 — 재물조사·감가상각·파일 업로드 없음) ──────

enum AssetCategory {
  EXERCISE_EQUIPMENT
  SAFETY_EQUIPMENT
  OFFICE_FURNITURE
  OTHER
}

enum AssetType {
  FIXED_ASSET
  CONSUMABLE
}

enum AssetStatus {
  NORMAL
  REPAIRING
  DISPOSAL_PENDING
  DISPOSED
}

model Asset {
  id              String        @id @default(uuid())
  assetCode       String        @unique // {지점코드}-A{순번}
  branchId        String
  name            String
  category        AssetCategory
  assetType       AssetType
  acquiredAt      DateTime      @db.Date
  acquisitionCost Int
  usefulLifeYears Int? // FIXED_ASSET만 사용
  status          AssetStatus
  quantity        Int // CONSUMABLE은 재고 수량, FIXED_ASSET은 항상 1
  location        String?
  note            String?

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

enum DocumentCategory {
  CONTRACT
  HR_RECORD
  MANUAL
  OTHER
}

model Document {
  id             String           @id @default(uuid())
  category       DocumentCategory
  branchId       String? // 전사 문서면 null
  relatedStaffId String? // HR_RECORD 대상 직원
  title          String
  fileUrl        String // 실제 파일 업로드 인프라는 아직 없음 — 문자열 필드일 뿐
  fileType       String?
  fileSize       Int?
  uploadedBy     String // FK → Account
  retentionUntil DateTime?        @db.Date // null = 영구 보관
  createdAt      DateTime         @default(now())
  deletedAt      DateTime? // 소프트 삭제(D9)

  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

// ── 공통: 변경 이력 ─────────────────────────────────────

// ── 공통: 채번 시퀀스 ───────────────────────────────────
// D27, ADR-STF-02 — 지점별 시퀀스 행을 SELECT ... FOR UPDATE로 잠그고 lastValue를 올린다(ADR-RSV-01과
// 같은 "잠글 대상이 반드시 있는 행을 잠근다" 패턴). mock의 "기존 개수+1"은 동시 요청(=Lambda 병렬
// 인스턴스)에서 같은 번호를 낸다. prefix: STAFF="{지점코드}-", MEMBER="{지점코드}{연도}", ASSET="{지점코드}-A".
enum CodeSequenceKind {
  STAFF
  MEMBER
  ASSET
}

model CodeSequence {
  branchId  String
  kind      CodeSequenceKind
  prefix    String
  lastValue Int              @default(0)

  branch Branch @relation(fields: [branchId], references: [id])

  @@id([branchId, kind, prefix])
}

// ── 공통: 회원 연동 실패 기록 ─────────────────────────────
// D27, ADR-MEM-01 — memberNo 기준 1시간 슬라이딩 윈도 5회 제한. mock은 인스턴스 메모리 Map이라 Lambda처럼
// 인스턴스가 여러 개면 제한이 인스턴스 수만큼 느슨해진다 → 공유 저장소(DB)로 옮긴다.
model MemberLinkAttempt {
  id          String   @id @default(uuid())
  memberNo    String
  attemptedAt DateTime @default(now())

  @@index([memberNo, attemptedAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  entity    String
  entityId  String
  action    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  actor Account? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
}

# D27 — DATABASE_URL = 앱 런타임 연결, DIRECT_URL = 마이그레이션 전용 직접 연결. 로컬은 둘 다 같은 값.
# Supabase/Lambda: DATABASE_URL은 트랜잭션 풀러(6543, ?pgbouncer=true&connection_limit=1), DIRECT_URL은 직접 연결(5432).
DATABASE_URL="postgresql://sports_erp:change-me-in-local-env@localhost:5432/sports_erp?schema=public"
DIRECT_URL="postgresql://sports_erp:change-me-in-local-env@localhost:5432/sports_erp?schema=public"
JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="30m"
JWT_REFRESH_SECRET="change-me-too"
JWT_REFRESH_EXPIRES_IN="14d"
PORT=3000

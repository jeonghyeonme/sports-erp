{
  "name": "sports-erp",
  "private": true,
  "version": "0.1.0",
  "description": "스포이즘 ERP 포트폴리오 프로젝트 (모노레포)",
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/admin-web",
    "dev:member": "npm run dev --workspace=apps/member-web",
    "build:web": "npm run build --workspace=apps/admin-web && npm run build --workspace=apps/member-web",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "prisma:generate": "npm run prisma:generate --workspace=apps/api",
    "prisma:migrate": "npm run prisma:migrate --workspace=apps/api",
    "e2e": "npm test --workspace=e2e"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "htmlparser2": "10.1.0",
    "body-parser": "1.20.8",
    "qs": "6.16.1",
    "multer": "2.4.0",
    "lodash": "4.18.1",
    "file-type": "21.3.4",
    "picomatch@4": "4.0.7",
    "glob@10": "10.5.0",
    "ajv@8": "8.20.0",
    "webpack": "5.112.0",
    "tmp": "0.2.7"
  }
}
